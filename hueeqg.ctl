// @ART-param: ["lcurve", "L", 2, ["ControlPoints", 0.0, 0.5, 0.35, 0.35, 0.16666666666666666, 0.5, 0.35, 0.35, 0.3333333333333333, 0.5, 0.35, 0.35, 0.5, 0.5, 0.35, 0.35, 0.6666666666666666, 0.5, 0.35, 0.35, 0.8333333333333333, 0.5, 0.35, 0.35], [[0.0, 0.7146, 0.4064, 0.5291], [0.0416666667, 0.7196, 0.4164, 0.4799], [0.0833333333, 0.7144, 0.4344, 0.4311], [0.125, 0.699, 0.4586, 0.3858], [0.1666666667, 0.6733, 0.4866, 0.3483], [0.2083333333, 0.6377, 0.5165, 0.3234], [0.25, 0.5923, 0.546, 0.3155], [0.2916666667, 0.5378, 0.5736, 0.3266], [0.3333333333, 0.4751, 0.5976, 0.3547], [0.375, 0.4055, 0.6167, 0.3953], [0.4166666667, 0.3315, 0.6301, 0.4433], [0.4583333333, 0.2583, 0.6368, 0.4942], [0.5, 0.1984, 0.6367, 0.5445], [0.5416666667, 0.1767, 0.6297, 0.5914], [0.5833333333, 0.2081, 0.616, 0.6326], [0.625, 0.2716, 0.5964, 0.666], [0.6666666667, 0.3445, 0.5719, 0.6902], [0.7083333333, 0.4166, 0.5437, 0.7042], [0.75, 0.4839, 0.5136, 0.7074], [0.7916666667, 0.5442, 0.4833, 0.6997], [0.8333333333, 0.5965, 0.4552, 0.6817], [0.875, 0.6402, 0.4314, 0.6541], [0.9166666667, 0.6746, 0.4143, 0.6184], [0.9583333333, 0.6995, 0.4056, 0.576], [1.0, 0.7146, 0.4064, 0.5291]], 0, "$CTL_CHANNEL;Channel"]
// @ART-param: ["smoothing", "Hue smoothing", true]
// @ART-guides: ["H"]
void ART_main(varying float r, varying float g, varying float b,
              varying float guide_h, 
              output varying float rout,
              output varying float gout,
              output varying float bout,
              float hcurve[256], float scurve[256], float lcurve[256],
              bool smoothing)
{
    float hsl[3] = to_hsl(r, g, b);
    float h = hue01(ite(smoothing, guide_h, hsl[0]));
    float v = luteval(hcurve, h);
    float f = tolin(v, 50) * M_PI;
    hsl[0] = hsl[0] + f;
    v = luteval(scurve, h);
    f = tolin(v, 2);
    float s = fmax(1.0 + f, 0);
    hsl[1] = hsl[1] * s;
    v = luteval(lcurve, h);
    s = fmin(jzhcl_ok_chroma(hsl), 1);
    f = tolin(v, 10);
    // as OKLab's L was scaled by 2^(10*f*s), i.e. the luminance by 2^(30*f*s)
    hsl[2] = jzhcl_lightness_gain(hsl[2], pow(2, 30 * f * s));
    float rgb[3] = to_rgb(hsl);
    rout = rgb[0];
    gout = rgb[1];
    bout = rgb[2];
}

// @ART-pipette: ["hcurve", "scurve", "lcurve"]
void ART_fill_pipette(varying float r, varying float g, varying float b,
                      varying float guide_h,
                      output varying float rout,
                      output varying float gout,
                      output varying float bout,
                      int curve_id, bool smoothing)
{
    float hsl[3] = to_hsl(r, g, b);
    float h = hue01(ite(smoothing, guide_h, hsl[0]));
    rout = h;
    gout = h;
    bout = h;
}
