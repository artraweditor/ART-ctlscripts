// @ART-label: "$CTL_GRAPHICAL_EQUALIZER_BY_HUE;Graphical equalizer by hue"
// @ART-colorspace: "rec2020"

import "_artlib";

float hue01(float h)
{
    float v = h / (2 * M_PI);
    if (v < 0.0) {
        return 1.0 + v;
    } else if (v > 1.0) {
        return v - 1.0;
    } else {
        return v;
    }
}

float tolin(float y, float base)
{
    float v = (y - 0.5) * 2.0;
    return sgn(v) * clamp(log2lin(fabs(v), base), 0, 1);
}

float[3] to_hsl(float r, float g, float b)
{
    return rgb2jzhcl(r, g, b);
}

float[3] to_rgb(float hsl[3])
{
    return jzhcl2rgb(hsl);
}

